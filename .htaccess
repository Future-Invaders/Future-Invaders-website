ErrorDocument 404 https://futureinvaders.com/404
Options -Indexes

# Enforce HTTPS
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?futureinvaders\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# API routes
RewriteRule ^api/arsenal/(.*)$ api/arsenal/arsenal.php?uuid=$1 [QSA,NC]
RewriteRule ^api/card/(.*)$ api/card/card.php?uuid=$1 [QSA,NC]
RewriteRule ^api/image/(.*)$ api/image/image.php?uuid=$1 [QSA,NC]
RewriteRule ^api/ruling/(.*)$ api/ruling/ruling.php?uuid=$1 [QSA,NC]
RewriteRule ^api/tag/(.*)$ api/tag/tag.php?uuid=$1 [QSA,NC]

# Cards
RewriteRule ^card/(.*)$ cards/card.php?slug=$1 [QSA,NC]

# Arsenals
RewriteRule ^arsenal/(.*)$ cards/arsenal.php?slug=$1 [QSA,NC]

# Rulings
RewriteRule ^ruling/(.*)$ cards/ruling.php?slug=$1 [QSA,NC]